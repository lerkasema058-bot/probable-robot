{
  "name": "probable-robot",
  "version": "0.2.0",
  "description": "Студия видео для детей — генератор видео из текста, эмодзи, фото и музыки прямо в браузере",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "npx serve dist -l 3000 -s",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.15.0",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
